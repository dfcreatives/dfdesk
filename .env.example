# Railway injects this when you add a PostgreSQL service and reference its URL.
# Keep it server-only: do not rename it to NEXT_PUBLIC_DATABASE_URL.
DATABASE_URL=postgresql://postgres:password@host:5432/railway?schema=desk

PORT=4000
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:3000
COOKIE_NAME=desk_session
COOKIE_SECURE=false
SESSION_TTL_DAYS=14
LOG_LEVEL=info

# Shared server-to-server integration settings. Generate a random secret with
# at least 32 characters and configure the same value in Frames 41.
FRAMES41_API_URL=https://frames-41-test-production.up.railway.app
DF_INTEGRATION_SECRET=replace-with-a-long-random-secret

# Required only by migration scripts. Both must exactly match DATABASE_URL.
MIGRATION_TARGET_HOST=host
MIGRATION_TARGET_DATABASE=railway
